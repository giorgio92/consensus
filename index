<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#FAFAF9">
<title>Clear Aligner Therapy — Delphi Consensus</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;600;700&display=swap');

  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}

  :root{
    --bg:#FAFAF9;--card:#FFF;--text:#1A1A1A;--text2:#6B6B6B;
    --accent:#2563EB;--accent-l:#DBEAFE;
    --green:#059669;--green-l:#D1FAE5;
    --red:#DC2626;--red-l:#FEE2E2;
    --border:#E5E5E5;
    --r:14px;
    --shadow:0 1px 3px rgba(0,0,0,0.06);
    --shadow-lg:0 8px 30px rgba(0,0,0,0.08);
  }

  body{
    font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
    background:var(--bg);color:var(--text);
    overflow-x:hidden;line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }

  /* ── HERO ── */
  .hero{
    position:relative;min-height:100vh;min-height:100dvh;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    text-align:center;padding:2rem 1.25rem;overflow:hidden;
  }
  .hero canvas{position:absolute;top:0;left:0;width:100%;height:100%;z-index:0;}
  .hero-content{position:relative;z-index:1;max-width:680px;}
  .badge{
    display:inline-block;background:var(--accent-l);color:var(--accent);
    font-size:0.65rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;
    padding:5px 14px;border-radius:100px;margin-bottom:1.2rem;
  }
  .hero h1{
    font-family:'Playfair Display',serif;
    font-size:clamp(1.8rem,5.5vw,3.2rem);font-weight:700;line-height:1.15;margin-bottom:1rem;
  }
  .hero p{font-size:clamp(0.88rem,2.5vw,1.05rem);color:var(--text2);max-width:540px;margin:0 auto 2rem;}
  .stats{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem 2rem;}
  @media(min-width:500px){.stats{grid-template-columns:repeat(4,1fr);gap:2rem;}}
  .stat-n{font-family:'Playfair Display',serif;font-size:clamp(2rem,6vw,2.8rem);font-weight:700;color:var(--accent);}
  .stat-l{font-size:0.72rem;color:var(--text2);font-weight:500;margin-top:2px;}
  .scroll-hint{
    position:absolute;bottom:1.5rem;z-index:1;
    animation:bob 2s ease-in-out infinite;
    color:var(--text2);font-size:0.75rem;letter-spacing:0.05em;
  }
  @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(6px)}}

  /* ── SECTIONS ── */
  section{padding:3.5rem 1.25rem;max-width:960px;margin:0 auto;}
  @media(min-width:600px){section{padding:5rem 2rem;}}
  .s-label{font-size:0.65rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--accent);margin-bottom:0.4rem;}
  .s-title{font-family:'Playfair Display',serif;font-size:clamp(1.5rem,4vw,2.2rem);font-weight:600;margin-bottom:0.8rem;}
  .s-desc{color:var(--text2);max-width:560px;margin-bottom:2.5rem;font-size:clamp(0.88rem,2.2vw,1rem);}

  /* ── 3D CANVAS ── */
  #three-canvas{
    width:100%;height:clamp(320px,55vw,550px);
    border-radius:var(--r);box-shadow:var(--shadow-lg);background:#fff;
    touch-action:none;cursor:grab;
  }
  #three-canvas:active{cursor:grabbing;}
  .viz-legend{display:flex;gap:1rem;justify-content:center;margin-top:1rem;flex-wrap:wrap;}
  .viz-legend-item{display:flex;align-items:center;gap:5px;font-size:0.72rem;color:var(--text2);}
  .viz-dot{width:10px;height:10px;border-radius:3px;}

  /* ── TOOLTIP (desktop) ── */
  #tooltip{
    position:fixed;pointer-events:none;background:#fff;border:1px solid var(--border);
    border-radius:12px;padding:12px 16px;box-shadow:var(--shadow-lg);
    max-width:300px;font-size:0.82rem;line-height:1.5;opacity:0;transition:opacity 0.15s;z-index:999;
  }
  #tooltip.show{opacity:1;}
  .tt-cat{font-size:0.62rem;text-transform:uppercase;letter-spacing:0.08em;font-weight:700;color:var(--accent);}
  .tt-title{font-weight:600;margin:3px 0 6px;font-size:0.85rem;}
  .tt-bw{background:#F3F4F6;border-radius:5px;height:7px;overflow:hidden;margin:5px 0 3px;}
  .tt-b{height:100%;border-radius:5px;}
  .tt-meta{display:flex;justify-content:space-between;font-size:0.7rem;color:var(--text2);}

  /* ── MOBILE INFO PANEL (replaces tooltip on touch) ── */
  #info-panel{
    display:none;position:fixed;bottom:0;left:0;right:0;
    background:#fff;border-top:1px solid var(--border);
    border-radius:16px 16px 0 0;box-shadow:0 -4px 20px rgba(0,0,0,0.1);
    padding:16px 20px 24px;z-index:999;
    transform:translateY(100%);transition:transform 0.3s ease;
  }
  #info-panel.show{transform:translateY(0);}
  @media(max-width:768px){#info-panel{display:block;}#tooltip{display:none;}}
  .ip-handle{width:36px;height:4px;background:#ddd;border-radius:2px;margin:0 auto 12px;}
  .ip-cat{font-size:0.62rem;text-transform:uppercase;letter-spacing:0.08em;font-weight:700;color:var(--accent);}
  .ip-title{font-weight:600;margin:4px 0 10px;font-size:0.95rem;}
  .ip-bar-wrap{background:#F3F4F6;border-radius:6px;height:10px;overflow:hidden;margin:6px 0 6px;}
  .ip-bar{height:100%;border-radius:6px;transition:width 0.3s;}
  .ip-meta{display:flex;justify-content:space-between;font-size:0.78rem;color:var(--text2);}

  /* ── CATEGORY CARDS ── */
  .cat-grid{display:flex;flex-direction:column;gap:1.25rem;}
  @media(min-width:640px){.cat-grid{display:grid;grid-template-columns:repeat(2,1fr);}}
  .cat-card{
    background:var(--card);border:1px solid var(--border);border-radius:var(--r);
    padding:1.5rem;transition:transform 0.2s,box-shadow 0.2s;
  }
  .cat-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg);}
  .cat-icon{
    width:40px;height:40px;border-radius:10px;
    display:flex;align-items:center;justify-content:center;
    font-size:1.15rem;margin-bottom:0.8rem;
  }
  .cat-card h3{font-size:0.95rem;font-weight:600;margin-bottom:0.35rem;}
  .cat-card>p{font-size:0.8rem;color:var(--text2);margin-bottom:1rem;}
  .stmts{display:flex;flex-direction:column;gap:0.7rem;}
  .sr{display:flex;align-items:center;gap:0.6rem;}
  .sn{
    min-width:24px;height:24px;border-radius:7px;
    display:flex;align-items:center;justify-content:center;
    font-size:0.65rem;font-weight:700;flex-shrink:0;
  }
  .sn.c{background:var(--green-l);color:var(--green);}
  .sn.n{background:var(--red-l);color:var(--red);}
  .sb-wrap{flex:1;background:#F3F4F6;border-radius:5px;height:7px;overflow:hidden;}
  .sb{height:100%;border-radius:5px;transition:width 1s ease;}
  .sp{font-size:0.7rem;font-weight:600;min-width:34px;text-align:right;}
  .st-label{font-size:0.72rem;color:#444;margin-bottom:3px;line-height:1.4;}

  /* ── METHODOLOGY ── */
  .tl{position:relative;padding-left:24px;}
  .tl::before{content:'';position:absolute;left:6px;top:4px;bottom:4px;width:2px;background:var(--border);}
  .tl-i{position:relative;margin-bottom:1.5rem;}
  .tl-d{
    position:absolute;left:-21px;top:3px;width:12px;height:12px;
    border-radius:50%;background:var(--accent);border:3px solid var(--bg);
  }
  .tl-i h4{font-size:0.88rem;font-weight:600;margin-bottom:3px;}
  .tl-i p{font-size:0.82rem;color:var(--text2);}

  /* ── SUMMARY ── */
  .sg{display:grid;grid-template-columns:1fr;gap:1rem;margin-top:1.5rem;}
  @media(min-width:500px){.sg{grid-template-columns:repeat(2,1fr);}}
  .sb-box{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:1.25rem;}
  .sb-box h4{font-size:0.85rem;font-weight:600;margin-bottom:0.4rem;}
  .sb-box p{font-size:0.8rem;color:var(--text2);}

  /* ── FOOTER ── */
  footer{text-align:center;padding:2.5rem 1.25rem;font-size:0.72rem;color:var(--text2);border-top:1px solid var(--border);max-width:960px;margin:0 auto;}
</style>
</head>
<body>

<!-- HERO -->
<div class="hero">
  <canvas id="hero-canvas"></canvas>
  <div class="hero-content">
    <div class="badge">Delphi Consensus Study — 2025</div>
    <h1>Indications &amp; Limits of Clear Aligner Therapy</h1>
    <p>23 international orthodontic experts evaluated 25 clinical statements across 3 voting rounds to reach evidence-based consensus.</p>
    <div class="stats">
      <div><div class="stat-n" id="a-exp">0</div><div class="stat-l">Expert Panelists</div></div>
      <div><div class="stat-n" id="a-stm">0</div><div class="stat-l">Statements</div></div>
      <div><div class="stat-n" id="a-con">0</div><div class="stat-l">Consensus</div></div>
      <div><div class="stat-n" id="a-rnd">0</div><div class="stat-l">Rounds</div></div>
    </div>
  </div>
  <div class="scroll-hint">↓ Scroll to explore</div>
</div>

<!-- 3D VIZ -->
<section id="viz-section">
  <div class="s-label">Interactive 3D View</div>
  <div class="s-title">Consensus Landscape</div>
  <div class="s-desc">Each column = one statement. Height = agreement %. Drag to rotate, pinch to zoom. Tap a bar for details.</div>
  <div id="three-canvas"></div>
  <div class="viz-legend">
    <div class="viz-legend-item"><div class="viz-dot" style="background:#059669"></div> Consensus</div>
    <div class="viz-legend-item"><div class="viz-dot" style="background:#DC2626"></div> No consensus</div>
    <div class="viz-legend-item"><div class="viz-dot" style="background:linear-gradient(to top,#e5e5e5,#2563EB)"></div> Height = Agreement %</div>
  </div>
</section>

<!-- Tooltip desktop -->
<div id="tooltip"><div class="tt-cat"></div><div class="tt-title"></div><div class="tt-bw"><div class="tt-b"></div></div><div class="tt-meta"><span class="tt-a"></span><span class="tt-r"></span></div></div>

<!-- Info Panel mobile -->
<div id="info-panel">
  <div class="ip-handle"></div>
  <div class="ip-cat"></div>
  <div class="ip-title"></div>
  <div class="ip-bar-wrap"><div class="ip-bar"></div></div>
  <div class="ip-meta"><span class="ip-a"></span><span class="ip-r"></span></div>
</div>

<!-- CATEGORY CARDS -->
<section>
  <div class="s-label">Results by Category</div>
  <div class="s-title">Six Areas of Investigation</div>
  <div class="s-desc">Statements assessed on a 5-point Likert scale. ≥70% agreement required for consensus.</div>
  <div class="cat-grid" id="cat-grid"></div>
</section>

<!-- METHODOLOGY -->
<section>
  <div class="s-label">Study Design</div>
  <div class="s-title">Modified Delphi Method</div>
  <div class="s-desc">Multi-round anonymous voting for unbiased expert agreement.</div>
  <div class="tl">
    <div class="tl-i"><div class="tl-d"></div><h4>Literature Review — Oct 2024</h4><p>Steering committee selected 15 key papers across 6 categories via systematic PubMed searches.</p></div>
    <div class="tl-i"><div class="tl-d"></div><h4>Round 1 — Jan 2025</h4><p>23 panelists rated 25 statements. 8 reached immediate consensus; 14 forwarded, 3 unresolved.</p></div>
    <div class="tl-i"><div class="tl-d"></div><h4>Round 2 — Jan–Feb 2025</h4><p>15 statements re-evaluated after rephrasing. 7 more reached consensus; 2 rejected; 6 forwarded.</p></div>
    <div class="tl-i"><div class="tl-d"></div><h4>Round 3 — Feb–Mar 2025</h4><p>6 final statements voted. 5 reached consensus, 1 rejected. No 4th round needed.</p></div>
  </div>
  <div class="sg">
    <div class="sb-box"><h4>Key Finding</h4><p>Clear aligners are effective for Class I non-extraction cases with mild-to-moderate crowding, matching fixed appliances.</p></div>
    <div class="sb-box"><h4>Quality of Life</h4><p>Patients experience better oral health-related quality of life and less pain during treatment with clear aligners.</p></div>
    <div class="sb-box"><h4>Biomechanical Limits</h4><p>Expansion is primarily crown tipping, not bodily movement. Premolar/canine corrections often need auxiliaries.</p></div>
    <div class="sb-box"><h4>Open Questions</h4><p>No consensus on treatment duration vs. fixed appliances, skeletal effects in growing patients, or full periodontal management.</p></div>
  </div>
</section>

<footer>
  D'Antò, Oliva, Franchi et al. · Progress in Orthodontics (2025) 26:28 · Interactive visualization
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
// ── DATA ──
const cats=[
  {id:'efficacy',name:'Efficacy & Efficiency',color:'#2563EB',icon:'⚡',desc:'Treatment outcomes vs fixed appliances'},
  {id:'qol',name:'Quality of Life',color:'#7C3AED',icon:'😊',desc:'Patient experience and pain during treatment'},
  {id:'side',name:'Side Effects',color:'#DB2777',icon:'⚠️',desc:'Phonetics, root resorption, white spots'},
  {id:'growing',name:'Growing Patients',color:'#EA580C',icon:'🌱',desc:'Skeletal expansion in developing patients'},
  {id:'extract',name:'Extraction Treatment',color:'#0891B2',icon:'🦷',desc:'Complex cases with premolar extractions'},
  {id:'perio',name:'Periodontal Health',color:'#16A34A',icon:'🩺',desc:'Plaque, gingival health, compromised patients'}
];
const S=[
  {id:1,cat:'efficacy',agree:65,sd:4,d:13,con:false,rnd:3,txt:'Treatment duration vs fixed appliances'},
  {id:2,cat:'efficacy',agree:91,sd:0,d:4,con:true,rnd:3,txt:'Effective for Class I mild-moderate crowding'},
  {id:3,cat:'efficacy',agree:87,sd:0,d:4,con:true,rnd:2,txt:'Aligner changes every 7–14 days'},
  {id:4,cat:'efficacy',agree:87,sd:0,d:4,con:true,rnd:3,txt:'Effective for open bite cases'},
  {id:5,cat:'efficacy',agree:96,sd:0,d:0,con:true,rnd:3,txt:'Expansion = crown tipping, not bodily movement'},
  {id:6,cat:'efficacy',agree:74,sd:0,d:9,con:true,rnd:2,txt:'Upper molar distalization up to 2.5 mm'},
  {id:7,cat:'efficacy',agree:91,sd:0,d:9,con:true,rnd:3,txt:'Premolar/canine corrections need auxiliaries'},
  {id:8,cat:'efficacy',agree:78,sd:0,d:4,con:true,rnd:3,txt:'Relapse similar to fixed (low evidence)'},
  {id:9,cat:'efficacy',agree:91,sd:0,d:4,con:true,rnd:1,txt:'Unpredictable movements → more refinements'},
  {id:10,cat:'efficacy',agree:83,sd:4,d:4,con:true,rnd:1,txt:'Unpredictable movements → switch to fixed'},
  {id:11,cat:'efficacy',agree:87,sd:4,d:4,con:true,rnd:2,txt:'More expensive but less chair time'},
  {id:12,cat:'qol',agree:83,sd:4,d:4,con:true,rnd:1,txt:'Better OHRQoL than fixed appliances'},
  {id:13,cat:'qol',agree:87,sd:4,d:9,con:true,rnd:2,txt:'No QoL difference at end of treatment'},
  {id:14,cat:'qol',agree:83,sd:0,d:0,con:true,rnd:1,txt:'Less pain during treatment'},
  {id:15,cat:'side',agree:100,sd:0,d:0,con:true,rnd:2,txt:'Temporary phonetic issues (resolve in days)'},
  {id:16,cat:'side',agree:78,sd:0,d:9,con:true,rnd:3,txt:'Lower root resorption than fixed appliances'},
  {id:17,cat:'side',agree:97,sd:0,d:0,con:true,rnd:1,txt:'Fewer white spots and carious lesions'},
  {id:18,cat:'growing',agree:96,sd:0,d:4,con:true,rnd:1,txt:'RPE > aligners for skeletal expansion'},
  {id:19,cat:'growing',agree:52,sd:9,d:22,con:false,rnd:2,txt:'Skeletal effects in growing patients'},
  {id:20,cat:'extract',agree:91,sd:0,d:4,con:true,rnd:1,txt:'Extraction treatment effective for Class I'},
  {id:21,cat:'extract',agree:87,sd:0,d:4,con:true,rnd:1,txt:'Fewer occlusal contacts post-extraction'},
  {id:22,cat:'extract',agree:87,sd:4,d:4,con:true,rnd:1,txt:'Reduced torque & more tipping in 4-premolar ext.'},
  {id:23,cat:'perio',agree:100,sd:0,d:0,con:true,rnd:1,txt:'Less plaque & gingival bleeding'},
  {id:24,cat:'perio',agree:39,sd:13,d:43,con:false,rnd:2,txt:'Suitability for bodily movements in perio patients'},
  {id:25,cat:'perio',agree:96,sd:0,d:0,con:true,rnd:1,txt:'Suitable for tipping in periodontal migration'}
];

// ── HERO PARTICLES ──
(function(){
  const c=document.getElementById('hero-canvas'),ctx=c.getContext('2d');
  let W,H,pts=[];
  function resize(){W=c.width=c.offsetWidth;H=c.height=c.offsetHeight;}
  resize();window.addEventListener('resize',resize);
  const N=Math.min(50,Math.floor(window.innerWidth/20));
  for(let i=0;i<N;i++)pts.push({x:Math.random()*2e3,y:Math.random()*1200,r:Math.random()*2+0.5,vx:(Math.random()-.5)*.25,vy:(Math.random()-.5)*.25,o:Math.random()*.2+.05});
  (function draw(){
    ctx.clearRect(0,0,W,H);
    pts.forEach(p=>{p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=W;if(p.x>W)p.x=0;if(p.y<0)p.y=H;if(p.y>H)p.y=0;
      ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fillStyle=`rgba(37,99,235,${p.o})`;ctx.fill();});
    for(let i=0;i<pts.length;i++)for(let j=i+1;j<pts.length;j++){
      const dx=pts[i].x-pts[j].x,dy=pts[i].y-pts[j].y,d=Math.sqrt(dx*dx+dy*dy);
      if(d<120){ctx.beginPath();ctx.moveTo(pts[i].x,pts[i].y);ctx.lineTo(pts[j].x,pts[j].y);
        ctx.strokeStyle=`rgba(37,99,235,${.05*(1-d/120)})`;ctx.stroke();}}
    requestAnimationFrame(draw);
  })();
})();

// ── ANIMATE NUMBERS ──
function anim(el,t){let c=0;const s=Math.ceil(t/35);const iv=setInterval(()=>{c+=s;if(c>=t){c=t;clearInterval(iv);}el.textContent=c;},30);}
const obs=new IntersectionObserver(e=>{if(e[0].isIntersecting){
  anim(document.getElementById('a-exp'),23);anim(document.getElementById('a-stm'),25);
  anim(document.getElementById('a-con'),22);anim(document.getElementById('a-rnd'),3);obs.disconnect();}},{threshold:.3});
obs.observe(document.querySelector('.hero'));

// ── THREE.JS ──
(function(){
  const el=document.getElementById('three-canvas');
  const tooltip=document.getElementById('tooltip');
  const panel=document.getElementById('info-panel');
  const isMobile=window.innerWidth<769;
  const W=el.clientWidth,H=el.clientHeight;

  const scene=new THREE.Scene();
  scene.background=new THREE.Color(0xffffff);
  scene.fog=new THREE.Fog(0xffffff,25,55);

  const cam=new THREE.PerspectiveCamera(45,W/H,0.1,100);
  const renderer=new THREE.WebGLRenderer({antialias:!isMobile,powerPreference:'high-performance'});
  renderer.setSize(W,H);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
  renderer.shadowMap.enabled=!isMobile;
  if(!isMobile){renderer.shadowMap.type=THREE.PCFSoftShadowMap;}
  el.appendChild(renderer.domElement);

  scene.add(new THREE.AmbientLight(0xffffff,0.55));
  const dl=new THREE.DirectionalLight(0xffffff,0.75);
  dl.position.set(10,20,10);
  if(!isMobile){dl.castShadow=true;dl.shadow.mapSize.set(512,512);dl.shadow.camera.near=1;dl.shadow.camera.far=50;dl.shadow.camera.left=-20;dl.shadow.camera.right=20;dl.shadow.camera.top=20;dl.shadow.camera.bottom=-20;}
  scene.add(dl);
  scene.add(new THREE.DirectionalLight(0xdbeafe,0.3));

  // Ground
  const gm=new THREE.Mesh(new THREE.PlaneGeometry(45,45),new THREE.MeshStandardMaterial({color:0xf5f5f4,roughness:1}));
  gm.rotation.x=-Math.PI/2;gm.position.y=-0.01;if(!isMobile)gm.receiveShadow=true;scene.add(gm);
  scene.add(new THREE.GridHelper(40,40,0xe5e5e5,0xf0f0f0));

  // Color map
  const cc={};cats.forEach(c=>cc[c.id]=new THREE.Color(c.color));

  // Bars
  const bars=[];
  const sp=isMobile?1.5:1.8;
  const tw=(S.length-1)*sp;
  const sx=-tw/2;
  const maxH=isMobile?9:12;

  S.forEach((s,i)=>{
    const h=(s.agree/100)*maxH;
    const geo=new THREE.BoxGeometry(isMobile?.8:1,h,isMobile?.8:1);
    geo.translate(0,h/2,0);
    const col=cc[s.cat].clone();if(!s.con)col.set(0xDC2626);
    const mat=new THREE.MeshStandardMaterial({color:col,roughness:0.35,metalness:0.05,transparent:true,opacity:0.92});
    const m=new THREE.Mesh(geo,mat);
    m.position.x=sx+i*sp;m.castShadow=!isMobile;m.receiveShadow=!isMobile;
    m.userData={index:i,s:s};
    scene.add(m);bars.push(m);

    // Cap
    const capG=new THREE.BoxGeometry(isMobile?.85:1.05,0.07,isMobile?.85:1.05);
    const capM=new THREE.MeshStandardMaterial({color:0xffffff,roughness:0.1,metalness:0.2,transparent:true,opacity:0.55});
    const cap=new THREE.Mesh(capG,capM);cap.position.set(sx+i*sp,h,0);scene.add(cap);

    // Dot
    const dg=new THREE.SphereGeometry(isMobile?0.12:0.15,10,10);
    const dm=new THREE.MeshStandardMaterial({color:s.con?0x059669:0xDC2626,emissive:s.con?0x059669:0xDC2626,emissiveIntensity:0.3});
    const dot=new THREE.Mesh(dg,dm);dot.position.set(sx+i*sp,h+0.35,0);scene.add(dot);
  });

  // Camera orbit
  let theta=0.6,phi=0.8,radius=isMobile?32:28;
  function updateCam(){
    cam.position.x=radius*Math.sin(phi)*Math.cos(theta);
    cam.position.y=radius*Math.cos(phi);
    cam.position.z=radius*Math.sin(phi)*Math.sin(theta);
    cam.lookAt(0,3,0);
  }
  updateCam();

  // Mouse drag
  let drag=false,prev={x:0,y:0};
  el.addEventListener('mousedown',e=>{drag=true;prev={x:e.clientX,y:e.clientY};});
  window.addEventListener('mouseup',()=>drag=false);
  el.addEventListener('mousemove',e=>{
    if(drag){theta-=(e.clientX-prev.x)*0.005;phi=Math.max(0.2,Math.min(1.4,phi+(e.clientY-prev.y)*0.005));updateCam();prev={x:e.clientX,y:e.clientY};}
  });
  el.addEventListener('wheel',e=>{e.preventDefault();radius=Math.max(12,Math.min(50,radius+e.deltaY*0.02));updateCam();},{passive:false});

  // Touch
  let ts=null,ts2=null,initDist=0;
  el.addEventListener('touchstart',e=>{
    if(e.touches.length===1){ts={x:e.touches[0].clientX,y:e.touches[0].clientY};}
    if(e.touches.length===2){
      ts2=true;
      initDist=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
    }
  },{passive:true});
  el.addEventListener('touchmove',e=>{
    if(e.touches.length===1&&ts&&!ts2){
      const dx=e.touches[0].clientX-ts.x,dy=e.touches[0].clientY-ts.y;
      theta-=dx*0.006;phi=Math.max(0.2,Math.min(1.4,phi+dy*0.006));
      updateCam();ts={x:e.touches[0].clientX,y:e.touches[0].clientY};
    }
    if(e.touches.length===2&&ts2){
      const d=Math.hypot(e.touches[0].clientX-e.touches[1].clientX,e.touches[0].clientY-e.touches[1].clientY);
      radius=Math.max(12,Math.min(50,radius-(d-initDist)*0.08));
      initDist=d;updateCam();
    }
  },{passive:true});
  el.addEventListener('touchend',()=>{ts=null;ts2=null;});

  // Raycaster
  const rc=new THREE.Raycaster(),mouse=new THREE.Vector2();
  let hovered=null;

  function showInfo(s,cat,barColor){
    if(isMobile){
      panel.querySelector('.ip-cat').textContent=cat.name;
      panel.querySelector('.ip-cat').style.color=cat.color;
      panel.querySelector('.ip-title').textContent=`#${s.id}: ${s.txt}`;
      panel.querySelector('.ip-bar').style.width=s.agree+'%';
      panel.querySelector('.ip-bar').style.background=barColor;
      panel.querySelector('.ip-a').textContent=s.agree+'% agreement';
      panel.querySelector('.ip-r').textContent=(s.con?'✓ Consensus':'✗ No consensus')+' · Round '+s.rnd;
      panel.classList.add('show');
    }
  }

  // Desktop hover
  el.addEventListener('mousemove',e=>{
    const rect=el.getBoundingClientRect();
    mouse.x=((e.clientX-rect.left)/rect.width)*2-1;
    mouse.y=-((e.clientY-rect.top)/rect.height)*2+1;
    rc.setFromCamera(mouse,cam);
    const hits=rc.intersectObjects(bars);
    if(hits.length>0){
      const bar=hits[0].object,s=bar.userData.s,cat=cats.find(c=>c.id===s.cat);
      if(hovered!==bar){if(hovered)hovered.material.emissiveIntensity=0;hovered=bar;bar.material.emissive=new THREE.Color(0x333333);bar.material.emissiveIntensity=0.15;}
      const col=s.con?'#059669':'#DC2626';
      tooltip.querySelector('.tt-cat').textContent=cat.name;tooltip.querySelector('.tt-cat').style.color=cat.color;
      tooltip.querySelector('.tt-title').textContent=`#${s.id}: ${s.txt}`;
      tooltip.querySelector('.tt-b').style.width=s.agree+'%';tooltip.querySelector('.tt-b').style.background=col;
      tooltip.querySelector('.tt-a').textContent=s.agree+'% agreement';
      tooltip.querySelector('.tt-r').textContent=(s.con?'✓ Consensus':'✗ No consensus')+' · Round '+s.rnd;
      tooltip.style.left=(e.clientX+14)+'px';tooltip.style.top=(e.clientY-16)+'px';
      tooltip.classList.add('show');
    } else {
      if(hovered){hovered.material.emissiveIntensity=0;hovered=null;}tooltip.classList.remove('show');
    }
  });
  el.addEventListener('mouseleave',()=>{if(hovered){hovered.material.emissiveIntensity=0;hovered=null;}tooltip.classList.remove('show');});

  // Mobile tap
  el.addEventListener('click',e=>{
    if(!isMobile)return;
    const rect=el.getBoundingClientRect();
    mouse.x=((e.clientX-rect.left)/rect.width)*2-1;
    mouse.y=-((e.clientY-rect.top)/rect.height)*2+1;
    rc.setFromCamera(mouse,cam);
    const hits=rc.intersectObjects(bars);
    if(hits.length>0){
      const bar=hits[0].object,s=bar.userData.s,cat=cats.find(c=>c.id===s.cat);
      if(hovered)hovered.material.emissiveIntensity=0;
      hovered=bar;bar.material.emissive=new THREE.Color(0x333333);bar.material.emissiveIntensity=0.15;
      showInfo(s,cat,s.con?'#059669':'#DC2626');
    } else {
      if(hovered){hovered.material.emissiveIntensity=0;hovered=null;}
      panel.classList.remove('show');
    }
  });

  // Dismiss panel on tap outside
  document.addEventListener('click',e=>{
    if(!el.contains(e.target)&&!panel.contains(e.target)){panel.classList.remove('show');}
  });

  // Auto-rotate
  let autoR=true;
  el.addEventListener('mousedown',()=>autoR=false);
  el.addEventListener('touchstart',()=>autoR=false,{passive:true});
  el.addEventListener('mouseup',()=>setTimeout(()=>autoR=true,3e3));
  el.addEventListener('touchend',()=>setTimeout(()=>autoR=true,3e3));

  (function animate(){requestAnimationFrame(animate);if(autoR){theta+=0.0008;updateCam();}renderer.render(scene,cam);})();

  window.addEventListener('resize',()=>{
    const w=el.clientWidth,h=el.clientHeight;cam.aspect=w/h;cam.updateProjectionMatrix();renderer.setSize(w,h);
  });
})();

// ── CATEGORY CARDS ──
(function(){
  const grid=document.getElementById('cat-grid');
  cats.forEach(cat=>{
    const sts=S.filter(s=>s.cat===cat.id);
    const cc=sts.filter(s=>s.con).length;
    const card=document.createElement('div');card.className='cat-card';
    card.innerHTML=`
      <div class="cat-icon" style="background:${cat.color}15;color:${cat.color}">${cat.icon}</div>
      <h3>${cat.name}</h3>
      <p>${cat.desc} — <strong>${cc}/${sts.length}</strong> consensus</p>
      <div class="stmts">${sts.map(s=>{
        const col=s.con?'#059669':'#DC2626';
        return `<div class="sr">
          <div class="sn ${s.con?'c':'n'}">${s.id}</div>
          <div style="flex:1"><div class="st-label">${s.txt}</div><div class="sb-wrap"><div class="sb" style="width:${s.agree}%;background:${col}"></div></div></div>
          <div class="sp" style="color:${col}">${s.agree}%</div>
        </div>`;}).join('')}</div>`;
    grid.appendChild(card);
  });
  const io=new IntersectionObserver(es=>{es.forEach(e=>{
    if(e.isIntersecting){e.target.querySelectorAll('.sb').forEach(b=>{const w=b.style.width;b.style.width='0%';requestAnimationFrame(()=>{b.style.transition='width 1s ease';b.style.width=w;});});io.unobserve(e.target);}
  });},{threshold:0.15});
  document.querySelectorAll('.cat-card').forEach(c=>io.observe(c));
})();
</script>
</body>
</html>
